# /srv/rbs/.env（install.sh が作ります）
RBS_HOME=/srv/rbs
RBS_UID=999
RBS_GID=999

SECRET_KEY=ここに長いランダム文字列

# Cloudflare Tunnel で繋ぐホスト名
PUBLIC_HOST=www.rbs-kyoto.org
ADMIN_HOST=admin.rbs-kyoto.org
PUBLIC_SITE_URL=https://www.rbs-kyoto.org/

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ログインを許可するメールのドメイン（自分のGmailで試すときは gmail.com）
GATE_ALLOWED_DOMAIN=rakunan-h.ed.jp

# コンテナがホストに開くポート（Cloudflare Tunnel の転送先）
WEB_PORT=80
ADMIN_PORT=8080
